# ==============================================================================
# CALYX FRONTEND: PRODUCTION MULTI-STAGE DOCKERFILE
# ==============================================================================
# Stage 1: Build static assets using Node.js & pnpm
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# Copy package configurations and install dependencies
COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

# Copy application source and compile production bundle
COPY frontend/ ./
RUN pnpm run build

# Stage 2: Serve production assets via high-performance NGINX
FROM nginx:alpine AS runner

# Copy custom NGINX configuration for Single Page Application (SPA) routing & microservice reverse proxy
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
